<?xml version="1.0" encoding="utf-8"?>
<!-- Dark, logo-free launch screen so the OS cold-start splash blends straight into the
     clay splash video's near-black opening frame (no white icon flash). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A0709" />
        </shape>
    </item>
</layer-list>
