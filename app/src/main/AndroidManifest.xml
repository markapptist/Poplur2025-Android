<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- A7: the incoming-call notification opens its ringing screen over the lock screen.
         On Android 14+ Play grants this to calling apps through the Data safety / permissions declaration. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <!-- A5: "Radio outside app" keeps Poplur in the foreground while a station plays. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="com.android.vending.BILLING"/>

    <queries>
        <package android:name="com.google.android.gms" />
        <package android:name="com.google.android.gsf" />
    </queries>

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <application android:name=".PoplurApp"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Poplur"
        android:label="Poplur"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="ca-app-pub-2086359936541081~8222991945"/>
        <meta-data android:name="com.mapbox.maps.token" android:value="@string/mapbox_access_token"/>
        <!-- Firebase Analytics: the web page owns screen_view (relayed over the bridge), so the SDK
             must not log one per Activity, and the Advertising ID is never collected. -->
        <meta-data android:name="google_analytics_automatic_screen_reporting_enabled" android:value="false"/>
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Poplur.SplashScreen"
            android:launchMode="singleTask"
            android:screenOrientation="portrait" />

        <activity-alias
            android:name=".launcher.DefaultIcon"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/app_icon_default"
            android:label="Poplur"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias android:name=".launcher.PastelIcon" android:enabled="false" android:exported="true" android:icon="@mipmap/app_icon_pastel" android:label="Poplur" android:targetActivity=".MainActivity"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
        <activity-alias android:name=".launcher.NeonBlueIcon" android:enabled="false" android:exported="true" android:icon="@mipmap/app_icon_neon_blue" android:label="Poplur" android:targetActivity=".MainActivity"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
        <activity-alias android:name=".launcher.RoseGoldIcon" android:enabled="false" android:exported="true" android:icon="@mipmap/app_icon_rose_gold" android:label="Poplur" android:targetActivity=".MainActivity"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
        <activity-alias android:name=".launcher.CamoIcon" android:enabled="false" android:exported="true" android:icon="@mipmap/app_icon_camo" android:label="Poplur" android:targetActivity=".MainActivity"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
        <activity-alias android:name=".launcher.ChocolateIcon" android:enabled="false" android:exported="true" android:icon="@mipmap/app_icon_chocolate" android:label="Poplur" android:targetActivity=".MainActivity"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
        <activity-alias android:name=".launcher.GoldIcon" android:enabled="false" android:exported="true" android:icon="@mipmap/app_icon_gold" android:label="Poplur" android:targetActivity=".MainActivity"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
        <activity-alias android:name=".launcher.IceIcon" android:enabled="false" android:exported="true" android:icon="@mipmap/app_icon_ice" android:label="Poplur" android:targetActivity=".MainActivity"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
        <activity-alias android:name=".launcher.RainbowIcon" android:enabled="false" android:exported="true" android:icon="@mipmap/app_icon_rainbow" android:label="Poplur" android:targetActivity=".MainActivity"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
        <activity-alias android:name=".launcher.RubberIcon" android:enabled="false" android:exported="true" android:icon="@mipmap/app_icon_rubber" android:label="Poplur" android:targetActivity=".MainActivity"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
        <activity-alias android:name=".launcher.SparklePinkIcon" android:enabled="false" android:exported="true" android:icon="@mipmap/app_icon_sparkle_pink" android:label="Poplur" android:targetActivity=".MainActivity"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
        <activity-alias android:name=".launcher.ToyIcon" android:enabled="false" android:exported="true" android:icon="@mipmap/app_icon_toy" android:label="Poplur" android:targetActivity=".MainActivity"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>

        <!-- DEBUG: launches straight into the native libGDX PoplurFPS game for verification -->
        <activity
            android:name=".FpsDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.Poplur"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="fullSensor" />

        <!-- DEBUG: renders just the 3D Mark head (SceneView) for verification -->
        <activity
            android:name=".HeadDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.Poplur"
            android:screenOrientation="portrait" />

        <!-- DEBUG: posts a sample Poplur system notification for verifying the
             clay-P small icon + clay large icon outside the app. -->
        <activity
            android:name=".NotificationDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.Poplur"
            android:screenOrientation="portrait" />

        <!-- DEBUG: renders the real ProfileScreen (with 3D head) for verification -->
        <activity
            android:name=".ProfileDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.Poplur"
            android:screenOrientation="portrait" />

        <!-- DEBUG: renders the real MapScreen for verification -->
        <activity
            android:name=".MapDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.Poplur"
            android:screenOrientation="portrait" />

        <!-- Native signed-out flow; no Expo or WebView runtime. -->
        <activity android:name=".NativePreloginActivity" android:exported="false"
            android:theme="@style/Theme.Poplur.PreloginWeb" android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait" />

        <!-- Pre-login web-embed host (Phase 1) — the approved prototype splash + welcome,
             offline-hardened, rendered in a WebView (assets/prelogin). Replaces the native
             WelcomeAuthScreen host as the pre-login entry until auth completes. -->
        <activity
            android:name=".PreloginWebActivity"
            android:exported="false"
            android:theme="@style/Theme.Poplur.PreloginWeb"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait" />

        <!-- Post-login web host — approved Loading screen over the approved clay-map Home,
             matching the iOS handoff and replacing the older native Compose landing path. -->
        <activity
            android:name=".PostLoginWebActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Poplur.PreloginWeb"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="com.apptists.poplur2025.OPEN_DM" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Clay web map (Phase 1 embed) — the Mapbox GL JS clay map from
             poplur-clay-map running in a WebView, same bundle as iOS -->
        <activity
            android:name=".ClayMapActivity"
            android:exported="true"
            android:theme="@style/Theme.Poplur"
            android:screenOrientation="portrait" />

        <!-- DEBUG: renders the cube hold menu (grid-card redesign) for verification -->
        <activity
            android:name=".HoldMenuDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.Poplur"
            android:screenOrientation="portrait" />

        <!-- DEBUG: renders the redesigned Profile Stats sub-screen -->
        <activity
            android:name=".StatsDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.Poplur"
            android:screenOrientation="portrait" />

        <!-- DEBUG: renders the redesigned DM/Messages screen (pink ChatC theme) -->
        <activity
            android:name=".MessagesDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.Poplur"
            android:screenOrientation="portrait" />

        <!-- DEBUG: renders the Welcome/Auth carousel (welcome/login/signup slide) -->
        <activity
            android:name=".WelcomeDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.Poplur"
            android:screenOrientation="portrait" />

        <!-- DEBUG: renders the Camera-tab hold menu (roll/create/home/chat/store) -->
        <activity
            android:name=".CameraHoldMenuDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.Poplur"
            android:screenOrientation="portrait" />

        <!-- DEBUG: renders the feed channel-logo bug (swoop-in/hold/fade) -->
        <activity
            android:name=".FeedLogoBugDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.Poplur"
            android:screenOrientation="portrait" />

        <!-- Engagement push notifications, phase 1: token rotations only.
             exported="false" — FCM binds this through the framework, so nothing
             outside the app should be able to start it. -->
        <service
            android:name=".PoplurMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- A7: calls that ring while Poplur is closed. The ringing screen shows over the lock
             screen in its own task; Decline is a broadcast so it never opens the app. -->
        <activity
            android:name=".call.IncomingCallActivity"
            android:exported="false"
            android:theme="@style/Theme.Poplur"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:screenOrientation="portrait" />

        <receiver
            android:name=".call.IncomingCallActionReceiver"
            android:exported="false" />

        <!-- A5: holds the foreground while the radio plays outside the app; the station
             itself plays in Home's WebView. -->
        <service
            android:name=".radio.RadioPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>
</manifest>
