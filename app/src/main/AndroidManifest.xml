<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="com.android.vending.BILLING"/>

    <queries>
        <package android:name="com.google.android.gms" />
        <package android:name="com.google.android.gsf" />
    </queries>

    <application android:name=".PoplurApp"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Poplur"
        android:label="Poplur"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="ca-app-pub-2086359936541081~4441297400"/>
        <meta-data android:name="com.mapbox.maps.token" android:value="@string/mapbox_access_token"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Poplur.SplashScreen"
            android:launchMode="singleTask"
            android:screenOrientation="portrait" />

        <activity-alias
            android:name=".launcher.DefaultIcon"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/app_icon_default"
            android:label="Poplur"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias android:name=".launcher.PastelIcon" android:enabled="false" android:exported="true" android:icon="@mipmap/app_icon_pastel" android:label="Poplur" android:targetActivity=".MainActivity"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
        <activity-alias android:name=".launcher.NeonBlueIcon" android:enabled="false" android:exported="true" android:icon="@mipmap/app_icon_neon_blue" android:label="Poplur" android:targetActivity=".MainActivity"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
        <activity-alias android:name=".launcher.RoseGoldIcon" android:enabled="false" android:exported="true" android:icon="@mipmap/app_icon_rose_gold" android:label="Poplur" android:targetActivity=".MainActivity"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>

        <!-- DEBUG: launches straight into the native libGDX PoplurFPS game for verification -->
        <activity
            android:name=".FpsDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.Poplur"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="fullSensor" />

        <!-- DEBUG: renders just the 3D Mark head (SceneView) for verification -->
        <activity
            android:name=".HeadDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.Poplur"
            android:screenOrientation="portrait" />

        <!-- DEBUG: posts a sample Poplur system notification for verifying the
             clay-P small icon + clay large icon outside the app. -->
        <activity
            android:name=".NotificationDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.Poplur"
            android:screenOrientation="portrait" />

        <!-- DEBUG: renders the real ProfileScreen (with 3D head) for verification -->
        <activity
            android:name=".ProfileDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.Poplur"
            android:screenOrientation="portrait" />

        <!-- DEBUG: renders the real MapScreen for verification -->
        <activity
            android:name=".MapDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.Poplur"
            android:screenOrientation="portrait" />

        <!-- Pre-login web-embed host (Phase 1) — the approved prototype splash + welcome,
             offline-hardened, rendered in a WebView (assets/prelogin). Replaces the native
             WelcomeAuthScreen host as the pre-login entry until auth completes. -->
        <activity
            android:name=".PreloginWebActivity"
            android:exported="false"
            android:theme="@style/Theme.Poplur.PreloginWeb"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait" />

        <!-- Post-login web host — approved Loading screen over the approved clay-map Home,
             matching the iOS handoff and replacing the older native Compose landing path. -->
        <activity
            android:name=".PostLoginWebActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Poplur.PreloginWeb"
            android:screenOrientation="portrait" />

        <!-- Clay web map (Phase 1 embed) — the Mapbox GL JS clay map from
             poplur-clay-map running in a WebView, same bundle as iOS -->
        <activity
            android:name=".ClayMapActivity"
            android:exported="true"
            android:theme="@style/Theme.Poplur"
            android:screenOrientation="portrait" />

        <!-- DEBUG: renders the cube hold menu (grid-card redesign) for verification -->
        <activity
            android:name=".HoldMenuDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.Poplur"
            android:screenOrientation="portrait" />

        <!-- DEBUG: renders the redesigned Profile Stats sub-screen -->
        <activity
            android:name=".StatsDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.Poplur"
            android:screenOrientation="portrait" />

        <!-- DEBUG: renders the redesigned DM/Messages screen (pink ChatC theme) -->
        <activity
            android:name=".MessagesDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.Poplur"
            android:screenOrientation="portrait" />

        <!-- DEBUG: renders the Welcome/Auth carousel (welcome/login/signup slide) -->
        <activity
            android:name=".WelcomeDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.Poplur"
            android:screenOrientation="portrait" />

        <!-- DEBUG: renders the Camera-tab hold menu (roll/create/home/chat/store) -->
        <activity
            android:name=".CameraHoldMenuDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.Poplur"
            android:screenOrientation="portrait" />

        <!-- DEBUG: renders the feed channel-logo bug (swoop-in/hold/fade) -->
        <activity
            android:name=".FeedLogoBugDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.Poplur"
            android:screenOrientation="portrait" />

    </application>
</manifest>
